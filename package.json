{
  "name": "local-mahjong-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude src/game/testMode/*.stress*.test.ts",
    "test:stress": "vitest run src/game/testMode/seededSimulation.stress.test.ts --testTimeout=120000",
    "test:stress:long": "vitest run src/game/testMode/seededSimulation.stressLong.test.ts --testTimeout=600000"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
