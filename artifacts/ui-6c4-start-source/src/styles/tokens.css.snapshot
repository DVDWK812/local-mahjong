:root {
  /* Motion: visual defaults only; playback speed remains Scheduler-owned. */
  --motion-fast: 120ms;
  --motion-normal: 160ms;

  /* Spacing */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 8px;

  /* Table and overlay layers */
  --z-table: 0;
  --z-tile: 1;
  --z-tile-accent: 2;
  --z-river: 10;
  --z-hand: 20;
  --z-table-ui: 30;
  --z-action: 50;
  --z-drawer: 80;
  --z-modal: 100;

  /* Shadows */
  --shadow-tile: 0 2px 5px rgba(25, 34, 30, 0.16);
  --shadow-action: 0 14px 38px rgba(0, 0, 0, 0.28);
  --shadow-modal: 0 24px 70px rgba(17, 29, 24, 0.32);

  /* Fixed-view table depth. These values describe presentation only. */
  --mahjong-table-perspective: 1500px;
  --mahjong-table-tilt: 2.8deg;
  --mahjong-table-edge-depth: 10px;
  --mahjong-table-surface-shadow: 0 18px 34px rgba(3, 17, 13, 0.34);
  --mahjong-tile-depth: 3px;
  --mahjong-tile-compact-depth: 2px;
  --mahjong-tile-local-depth: 4px;
  --mahjong-tile-river-depth: 2px;
  --mahjong-tile-meld-depth: 3px;
  --mahjong-tile-opponent-depth: 3px;
  --mahjong-tile-wall-depth: 5px;
  --mahjong-tile-contact-shadow: 1px 3px 3px rgba(4, 17, 20, 0.42);
  --mahjong-tile-edge-highlight: rgba(255, 255, 255, 0.78);
  --mahjong-tile-side: #425f66;
  --mahjong-tile-bottom: #263f46;

  /* Mahjong-specific presentation */
  --tile-radius: 7px;
  --tile-compact-radius: 5px;
  --tile-hover-offset: -3px;
  --tile-select-offset: -5px;
  --tile-selected-hover-offset: -6px;
  --tile-gap: var(--space-1);
  --drawn-tile-gap: clamp(8px, 1.4vw, 18px);
}
