.win-presentation-overlay {
  position: absolute;
  inset: 0;
  z-index: calc(var(--z-hand) + 2);
  overflow: hidden;
  pointer-events: none;
  contain: layout paint;
}

.win-presentation-overlay,
.win-presentation-overlay * {
  pointer-events: none !important;
}

.win-presentation-stage {
  position: absolute;
  left: var(--win-source-x);
  top: var(--win-source-y);
  transform: translate(-50%, -50%);
  transition: transform 280ms cubic-bezier(0.2, 0.78, 0.24, 1), opacity 100ms ease;
  transform-origin: center;
}

.win-presentation-stage[data-win-phase="push"],
.win-presentation-stage[data-win-phase="announce"],
.win-presentation-stage[data-win-phase="hold"] {
  transform: translate(calc(-50% + var(--win-push-x)), calc(-50% + var(--win-push-y)));
}

.win-presentation-stage[data-win-phase="cleanup"] {
  opacity: 0;
  transform: translate(calc(-50% + var(--win-push-x)), calc(-50% + var(--win-push-y))) scale(0.98);
}

.win-presentation-hand {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  filter: drop-shadow(0 7px 9px rgba(3, 15, 12, 0.34));
  transform-origin: center;
}

.win-presentation-stage[data-win-seat="top"] .win-presentation-hand { transform: rotate(180deg); }
.win-presentation-stage[data-win-seat="left"] .win-presentation-hand { transform: rotate(90deg); }
.win-presentation-stage[data-win-seat="right"] .win-presentation-hand { transform: rotate(-90deg); }

.win-presentation-tile {
  display: block;
  transform-origin: center bottom;
}

.win-presentation-tile--drawn {
  margin-left: 8px;
}

.win-presentation-stage[data-win-type="tsumo"][data-win-phase="slam"] .win-presentation-tile--drawn {
  animation: win-tile-slam 210ms cubic-bezier(0.18, 0.88, 0.28, 1) both;
}

.win-presentation-winning-discard .tile {
  filter: brightness(1.1) drop-shadow(0 0 5px rgba(255, 205, 82, 0.95));
  transform: scale(1.045);
}

.win-presentation-winning-discard {
  position: relative;
  z-index: calc(var(--z-river) + 1);
}

@keyframes win-tile-slam {
  0% { transform: translateY(-18px) scale(1.03); filter: drop-shadow(0 9px 7px rgba(2, 11, 9, 0.4)); }
  72% { transform: translateY(2px) scale(1.06, 0.96); filter: drop-shadow(0 2px 2px rgba(2, 11, 9, 0.45)); }
  100% { transform: translateY(0) scale(1); filter: drop-shadow(0 4px 3px rgba(2, 11, 9, 0.32)); }
}

@media (prefers-reduced-motion: reduce) {
  .win-presentation-stage,
  .win-presentation-tile--drawn {
    animation: none !important;
    transition: none !important;
  }
}
