.final-gate-controls { position: fixed; z-index: 10000; top: 4px; left: 4px; width: min(360px, calc(100vw - 8px)); color: #f4f1df; background: #10271fee; border: 1px solid #ae9964; border-radius: 6px; font-size: 12px; }
.final-gate-controls summary { cursor: pointer; padding: 7px; }
.final-gate-body { padding: 8px; max-height: min(65vh, 570px); overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }
.final-gate-body label { display: block; margin: 5px 0; }
.final-gate-body select { max-width: 100%; }
.final-gate-body button, .final-gate-body a { margin: 3px; }
.final-gate-body p { margin: 6px 0; }
.final-gate-body ol { padding-left: 20px; overflow-wrap: anywhere; }
.final-gate-body a { color: #e7cf8b; }
.final-gate-action { position: fixed; z-index: 9999; left: 6px; bottom: 6px; background: #10271fee; color: white; padding: 4px; font-size: 12px; }
